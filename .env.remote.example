# Remote PostgreSQL deployment example.
# Copy this file to .env on the target server, then replace every change-me value.
SECRET_KEY=change-me

# Use the remote PostgreSQL host that the application container can reach.
# If PostgreSQL runs on the same Linux host outside Docker, docker-compose.remote-db.yml
# also supports host.docker.internal through host-gateway.
DATABASE_URL=postgresql+psycopg2://valve:change-me@101.43.113.18:5432/valve

UPLOAD_DIR=/app/data/uploads
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
DEMO_USERNAME=viewer
DEMO_PASSWORD=change-me
SHOW_DEMO_CREDENTIALS=false
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
REMEMBER_COOKIE_SECURE=false
REMEMBER_COOKIE_SAMESITE=Lax
MAX_CONTENT_LENGTH=33554432
PROXY_FIX_X_FOR=1
PROXY_FIX_X_PROTO=1
PROXY_FIX_X_HOST=1
PROXY_FIX_X_PORT=1
PROXY_FIX_X_PREFIX=0
